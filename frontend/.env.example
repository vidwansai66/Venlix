# Frontend environment variables (Vite exposes VITE_* values to the browser).
# Use your own project values. Never put server-side secrets in this file.
VITE_API_URL=http://localhost:8000
VITE_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key

# EmailJS public client configuration
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key
VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
VITE_EMAILJS_TEMPLATE_ID=your-emailjs-template-id

# Supabase client configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Never add CLERK_SECRET_KEY or other server-side credentials to a Vite .env file.
